{% comment %}
  Purelane Reusable Product Card Snippet
  Handles:
  - Real Shopify product data (images, title, price, compare_at_price, vendor, availability)
  - Edge Case 1: Sold-out state badge and disabled button
  - Edge Case 2: Missing image fallback using default CSS styling / SVG placeholder
  - Edge Case 3: Long product titles safely truncated/clamped via CSS without breaking grid height
{% endcomment %}

<article class="purelane-card purelane-glass-2" id="purelane-product-card-{{ product.id | default: 'demo' }}">
  <div class="shot">
    {%- if product.available == false -%}
      <span class="pill pill-soldout">Sold Out</span>
    {%- elsif product.compare_at_price > product.price -%}
      {% assign discount = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round %}
      <span class="pill">{{ discount }}% OFF</span>
    {%- elsif product.tags contains 'Bestseller' or product.tags contains 'bestseller' -%}
      <span class="pill">Bestseller</span>
    {%- endif -%}

    <a href="{{ product.url }}" aria-label="{{ product.title | escape }}">
      {%- liquid
        assign bottle_class = 'p-kitchen'
        if product.handle contains 'tap'
          assign bottle_class = 'p-tap'
        elsif product.handle contains 'dish'
          assign bottle_class = 'p-dish'
        elsif product.handle contains 'floor'
          assign bottle_class = 'p-floor'
        elsif product.handle contains 'laundry'
          assign bottle_class = 'p-laundry'
        elsif product.handle contains 'handwash'
          assign bottle_class = 'p-handwash'
        elsif product.handle contains 'toilet'
          assign bottle_class = 'p-toilet'
        elsif product.handle contains 'metal'
          assign bottle_class = 'p-metal'
        endif
      -%}
      {%- if product.featured_media != blank and product.featured_media.preview_image != blank -%}
        <img
          src="{{ product.featured_media | image_url: width: 300 }}"
          alt="{{ product.featured_media.alt | default: product.title | escape }}"
          loading="lazy"
          width="300"
          height="300"
          onerror="this.style.display='none'; if(this.nextElementSibling) this.nextElementSibling.style.display='block';"
        >
        <div class="pimg {{ bottle_class }}" style="display: none;" aria-label="Purelane plant-powered homecare bottle"></div>
      {%- else -%}
        <div class="pimg {{ bottle_class }}" aria-label="Purelane plant-powered homecare bottle"></div>
      {%- endif -%}
    </a>
  </div>

  <h3 title="{{ product.title | escape }}">
    <a href="{{ product.url }}">{{ product.title }}</a>
  </h3>

  {%- assign eco_metafield = product.metafields.custom.eco_certifications | default: product.metafields.custom.eco_badge | default: product.metafields.custom.key_benefit -%}
  {%- if eco_metafield != blank -%}
    <div class="purelane-card-metafield">
      <span class="purelane-meta-pill">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
          <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
        </svg>
        {{ eco_metafield }}
      </span>
    </div>
  {%- endif -%}

  <div class="rate" aria-label="Rating 4.9 stars">
    <b>★ 4.9</b> <span>(120+ reviews)</span>
  </div>

  <div class="pr">
    <strong>{{ product.price | money }}</strong>
    {%- if product.compare_at_price > product.price -%}
      <s>{{ product.compare_at_price | money }}</s>
    {%- endif -%}
  </div>

  {%- if product.available -%}
    {%- assign product_form_id = 'purelane-form-' | append: section.id | append: '-' | append: product.id -%}
    <product-form data-section-id="{{ section.id }}">
      {%- form 'product', product, id: product_form_id, class: 'form purelane-card-form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        <button type="submit" name="add" class="purelane-btn purelane-btn-primary" aria-haspopup="dialog">
          <span>Add to cart</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h13m-5-6 6 6-6 6"/>
          </svg>
          <div class="loading__spinner hidden">
            <svg aria-hidden="true" focusable="false" class="spinner" viewBox="0 0 66 66" xmlns="http://www.w3.org/2000/svg">
              <circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
            </svg>
          </div>
        </button>
      {%- endform -%}
    </product-form>
  {%- else -%}
    {% comment %} Edge Case 1: Sold-out button handling {% endcomment %}
    <button type="button" class="purelane-btn purelane-btn-ghost purelane-btn-disabled" disabled>
      <span>Sold Out</span>
    </button>
  {%- endif -%}
</article>
