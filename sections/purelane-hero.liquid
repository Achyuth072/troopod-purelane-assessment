{% comment %}
  Section 01: Hero (section.hero)
  Merchant editable hero section matching prototype specifications
{% endcomment %}

{{ 'purelane-custom.css' | asset_url | stylesheet_tag }}

<section class="purelane-sec hero" id="purelane-hero-{{ section.id }}">
  <div class="hero-grid">
    <div class="badges purelane-glass-2" aria-label="Product promises">
      {%- for block in section.blocks -%}
        {%- if block.type == 'badge' -%}
          <div class="badge" {{ block.shopify_attributes }}>
            <span class="bi">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
                <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
              </svg>
            </span>
            <span>{{ block.settings.label }}</span>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="hero-copy">
      <h1 class="purelane-d1">
        {%- liquid
          assign formatted_heading = section.settings.heading | replace: 'Lasts', '<span class="purelane-lime">Lasts</span>'
          if formatted_heading contains '[' and formatted_heading contains ']'
            assign formatted_heading = formatted_heading | replace: '[', '<span class="purelane-lime">' | replace: ']', '</span>'
          endif
        -%}
        {{ formatted_heading }}
      </h1>

      <div class="purelane-rule">
        <i></i>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
          <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
        </svg>
        <i></i>
      </div>

      <p class="purelane-lede">
        {{ section.settings.subheading }}
      </p>

      <div class="hero-cta">
        {%- if section.settings.primary_cta_label != blank -%}
          <a class="purelane-btn purelane-btn-primary" href="{{ section.settings.primary_cta_link | default: '#shop' }}">
            {{ section.settings.primary_cta_label }}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h13m-5-6 6 6-6 6"/>
            </svg>
          </a>
        {%- endif -%}
        {%- if section.settings.secondary_cta_label != blank -%}
          <a class="purelane-btn purelane-btn-ghost" href="{{ section.settings.secondary_cta_link | default: '#how' }}">
            {{ section.settings.secondary_cta_label }}
          </a>
        {%- endif -%}
      </div>

      <div class="badgestrip">
        {%- for block in section.blocks -%}
          {%- if block.type == 'badge' -%}
            <div class="purelane-glass-2">
              {{ block.settings.label | replace: '<br>', ' ' }}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    <div class="purelane-hero-prod" id="heroProd-{{ section.id }}">
      <div class="purelane-hstage" id="hstage-{{ section.id }}">
        <div class="purelane-hslide hs1 on" data-n="1">
          <span class="purelane-hp p-kbtl a d1" role="img" aria-label="Purelane kitchen cleaner spray bottle"></span>
          <div class="purelane-glass-2 ptag">
            <span class="lbl">{{ section.settings.tier_1_title }}</span>
            <span class="val">
              <strong>{{ section.settings.tier_1_price }}</strong>
              <s>{{ section.settings.tier_1_compare_at }}</s>
            </span>
            <span class="cut">{{ section.settings.tier_1_tag }}</span>
          </div>
        </div>
        <div class="purelane-hslide hs2" data-n="2">
          <span class="purelane-hp p-tbtl a d1" role="img" aria-label="Purelane tap cleaner spray bottle"></span>
          <span class="purelane-hp p-kbtl b d2" role="img" aria-label="Purelane kitchen cleaner spray bottle"></span>
          <div class="purelane-glass-2 ptag">
            <span class="lbl">{{ section.settings.tier_2_title }}</span>
            <span class="val">
              <strong>{{ section.settings.tier_2_price }}</strong>
              <s>{{ section.settings.tier_2_compare_at }}</s>
            </span>
            <span class="cut">{{ section.settings.tier_2_tag }}</span>
          </div>
        </div>
        <div class="purelane-hslide hs3" data-n="3">
          <span class="purelane-hp p-tbtl a d1" role="img" aria-label="Purelane tap cleaner spray bottle"></span>
          <span class="purelane-hp p-mbtl b d2" role="img" aria-label="Purelane metal cleaner bottle"></span>
          <span class="purelane-hp p-kbtl c d3" role="img" aria-label="Purelane kitchen cleaner spray bottle"></span>
          <div class="purelane-glass-2 ptag">
            <span class="lbl">{{ section.settings.tier_3_title }}</span>
            <span class="val">
              <strong>{{ section.settings.tier_3_price }}</strong>
              <s>{{ section.settings.tier_3_compare_at }}</s>
            </span>
            <span class="cut">{{ section.settings.tier_3_tag }}</span>
          </div>
        </div>
      </div>
      <div class="hdots" id="hdots-{{ section.id }}" role="tablist" aria-label="Hero product stage navigation">
        <button type="button" role="tab" aria-selected="true" class="on" aria-label="Show 1 product tier"></button>
        <button type="button" role="tab" aria-selected="false" aria-label="Show 2 products tier"></button>
        <button type="button" role="tab" aria-selected="false" aria-label="Show 3 products tier"></button>
      </div>
    </div>
  </div>
</section>

<script>
  (function() {
    function initHeroStage(sectionId) {
      var hstage = document.getElementById('hstage-' + sectionId);
      var hdotsWrap = document.getElementById('hdots-' + sectionId);
      if (!hstage || !hdotsWrap) return;

      var hs = [].slice.call(hstage.querySelectorAll('.purelane-hslide'));
      var hd = [].slice.call(hdotsWrap.querySelectorAll('button'));
      var hi = 0;
      var htimer = null;
      var mediaQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
      var reduce = mediaQuery.matches;

      if (mediaQuery.addEventListener) {
        mediaQuery.addEventListener('change', function(e) {
          reduce = e.matches;
          if (reduce) {
            hstop();
          } else {
            hplay();
          }
        });
      }

      function hgo(n) {
        hi = (n + hs.length) % hs.length;
        hs.forEach(function(s, i) { s.classList.toggle('on', i === hi); });
        hd.forEach(function(d, i) {
          var isOn = (i === hi);
          d.classList.toggle('on', isOn);
          d.setAttribute('aria-selected', isOn ? 'true' : 'false');
        });
      }

      function hplay() {
        if (reduce) return;
        if (htimer) {
          clearInterval(htimer);
          htimer = null;
        }
        htimer = setInterval(function() {
          hgo(hi + 1);
        }, 3800);
      }

      function hstop() {
        if (htimer) {
          clearInterval(htimer);
          htimer = null;
        }
      }

      hd.forEach(function(d, i) {
        d.addEventListener('click', function() {
          hstop();
          hgo(i);
          hplay();
        });
      });

      hstage.addEventListener('mouseenter', hstop);
      hstage.addEventListener('mouseleave', hplay);

      if ('IntersectionObserver' in window) {
        var observer = new IntersectionObserver(function(entries) {
          entries.forEach(function(e) {
            if (e.isIntersecting) {
              hplay();
            } else {
              hstop();
            }
          });
        }, { threshold: 0.2 });
        observer.observe(hstage);
      } else {
        hplay();
      }
    }

    document.addEventListener('DOMContentLoaded', function() {
      initHeroStage('{{ section.id }}');
    });

    if (Shopify.designMode) {
      document.addEventListener('shopify:section:load', function(event) {
        if (event.detail.sectionId === '{{ section.id }}') {
          initHeroStage('{{ section.id }}');
        }
      });
    }
  })();
</script>

{% schema %}
