{% comment %}
  Section 01: Hero (section.hero)
  Merchant editable hero section matching prototype specifications
{% endcomment %}

{{ 'purelane-custom.css' | asset_url | stylesheet_tag }}

<section class="purelane-sec hero" id="purelane-hero-{{ section.id }}">
  <div class="hero-grid">
    <div class="badges purelane-glass-2" aria-label="Product promises">
      {%- for block in section.blocks -%}
        {%- if block.type == 'badge' -%}
          <div class="badge" {{ block.shopify_attributes }}>
            <span class="bi">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
                <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
              </svg>
            </span>
            <span>{{ block.settings.label }}</span>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="hero-copy">
      <h1 class="purelane-d1">
        {{ section.settings.heading | replace: 'Lasts', '<span class="purelane-lime">Lasts</span>' }}
      </h1>

      <div class="purelane-rule">
        <i></i>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
          <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
        </svg>
        <i></i>
      </div>

      <p class="purelane-lede">
        {{ section.settings.subheading }}
      </p>

      <div class="hero-cta">
        {%- if section.settings.primary_cta_label != blank -%}
          <a class="purelane-btn purelane-btn-primary" href="{{ section.settings.primary_cta_link | default: '#shop' }}">
            {{ section.settings.primary_cta_label }}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h13m-5-6 6 6-6 6"/>
            </svg>
          </a>
        {%- endif -%}
        {%- if section.settings.secondary_cta_label != blank -%}
          <a class="purelane-btn purelane-btn-ghost" href="{{ section.settings.secondary_cta_link | default: '#how' }}">
            {{ section.settings.secondary_cta_label }}
          </a>
        {%- endif -%}
      </div>

      <div class="badgestrip">
        {%- for block in section.blocks -%}
          {%- if block.type == 'badge' -%}
            <div class="purelane-glass-2">
              {{ block.settings.label | replace: '<br>', ' ' }}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    <div class="purelane-hero-prod" id="heroProd-{{ section.id }}">
      <div class="purelane-hstage">
        <div class="purelane-hslide hs1 on" data-n="1">
          <span class="purelane-hp p-kbtl a d1" role="img" aria-label="Purelane kitchen cleaner spray bottle"></span>
          <div class="purelane-glass-2 ptag">
            <span class="lbl">{{ section.settings.tier_1_title }}</span>
            <span class="val">
              <strong>{{ section.settings.tier_1_price }}</strong>
              <s>{{ section.settings.tier_1_compare_at }}</s>
            </span>
            <span class="cut">{{ section.settings.tier_1_tag }}</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Hero",
  "tag": "section",
  "class": "purelane-hero-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Clean That Lasts"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Homecare that works on the toughest grime, made from plants. Kind to your home, your family and the world outside it."
    },
    {
      "type": "text",
      "id": "primary_cta_label",
      "label": "Primary CTA Label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "primary_cta_link",
      "label": "Primary CTA Link"
    },
    {
      "type": "text",
      "id": "secondary_cta_label",
      "label": "Secondary CTA Label",
      "default": "How it works"
    },
    {
      "type": "url",
      "id": "secondary_cta_link",
      "label": "Secondary CTA Link"
    },
    {
      "type": "header",
      "content": "Stage Product Tag Settings"
    },
    {
      "type": "text",
      "id": "tier_1_title",
      "label": "Tier 1 Title",
      "default": "Single bottle"
    },
    {
      "type": "text",
      "id": "tier_1_price",
      "label": "Tier 1 Price",
      "default": "₹200"
    },
    {
      "type": "text",
      "id": "tier_1_compare_at",
      "label": "Tier 1 Compare Price",
      "default": "₹299"
    },
    {
      "type": "text",
      "id": "tier_1_tag",
      "label": "Tier 1 Tag",
      "default": "33% off"
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Value Badge",
      "settings": [
        {
          "type": "html",
          "id": "label",
          "label": "Badge Label (HTML supported)",
          "default": "Plant<br>powered"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Hero",
      "blocks": [
        {
          "type": "badge",
          "settings": { "label": "Plant<br>powered" }
        },
        {
          "type": "badge",
          "settings": { "label": "Safe for<br>kids & pets" }
        },
        {
          "type": "badge",
          "settings": { "label": "Zero harsh<br>chemicals" }
        }
      ]
    }
  ]
}
{% endschema %}
