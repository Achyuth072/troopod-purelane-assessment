{% comment %}
  Section 04: Bundles (#bundles)
  Merchant editable section for bundle tier choices
{% endcomment %}

{{ 'purelane-custom.css' | asset_url | stylesheet_tag }}

<section class="purelane-sec" id="bundles">
  <div class="purelane-wrap">
    <div class="purelane-glass purelane-sec-pad">
      <div class="purelane-panel-head">
        <h2 class="purelane-d2">{{ section.settings.heading }}</h2>
        <div class="purelane-rule">
          <i></i>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
            <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
          </svg>
          <i></i>
        </div>
        {%- if section.settings.subheading != blank -%}
          <p class="purelane-lede" style="margin: 12px auto 0;">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>

      <div class="purelane-tiers">
        {%- for block in section.blocks -%}
          <article class="purelane-tier purelane-glass-2 {% if block.settings.is_best_value %}best{% endif %}" {{ block.shopify_attributes }}>
            {%- if block.settings.badge != blank -%}
              <span class="tag">{{ block.settings.badge }}</span>
            {%- endif -%}

            <div class="qty">
              {{ block.settings.quantity_title }}
              <small>{{ block.settings.subtitle }}</small>
            </div>

            <div class="purelane-tierpix">
              <div class="pimg p-kitchen"></div>
              <div class="pimg p-tap"></div>
              <div class="pimg p-dish"></div>
            </div>

            <div class="price">
              {{ block.settings.price }}
              {%- if block.settings.compare_at != blank -%}
                <s>{{ block.settings.compare_at }}</s>
              {%- endif -%}
            </div>

            <ul>
              {%- assign features = block.settings.features | newline_to_br | split: '<br />' -%}
              {%- for feature in features -%}
                {%- if feature != blank -%}
                  <li>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M20 6 9 17l-5-5"/>
                    </svg>
                    <span>{{ feature | strip }}</span>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>

            <a class="purelane-btn purelane-btn-primary" href="{{ block.settings.button_link | default: '#shop' }}">
              {{ block.settings.button_label | default: 'Choose Bundle' }}
            </a>
          </article>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Bundles",
  "tag": "section",
  "class": "purelane-bundles-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Save Big With Bundles"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Stock up on plant-powered homecare essentials and enjoy up to 45% savings."
    }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Bundle Tier",
      "settings": [
        {
          "type": "checkbox",
          "id": "is_best_value",
          "label": "Highlight as Best Value",
          "default": false
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge Label",
          "default": "Starter Kit"
        },
        {
          "type": "text",
          "id": "quantity_title",
          "label": "Quantity Title",
          "default": "3 Pack"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "Essential trio"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "₹499"
        },
        {
          "type": "text",
          "id": "compare_at",
          "label": "Compare Price",
          "default": "₹897"
        },
        {
          "type": "textarea",
          "id": "features",
          "label": "Features List (One per line)",
          "default": "1x Kitchen Cleaner Spray\n1x Tap & Limescale Cleaner\n1x Dishwash Gel\nFree shipping nationwide"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button Label",
          "default": "Get 3-Pack Bundle"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Bundles",
      "blocks": [
        {
          "type": "tier",
          "settings": {
            "badge": "Starter Kit",
            "quantity_title": "3 Pack",
            "subtitle": "Essential Trio",
            "price": "₹499",
            "compare_at": "₹897"
          }
        },
        {
          "type": "tier",
          "settings": {
            "is_best_value": true,
            "badge": "Most Popular",
            "quantity_title": "5 Pack",
            "subtitle": "Whole Home Clean",
            "price": "₹799",
            "compare_at": "₹1,495"
          }
        }
      ]
    }
  ]
}
{% endschema %}
